# For a fresh account, use deployments/new-account/terraform.tfvars.example instead.
# This file is only for running terraform/ as an independent root configuration.
expected_account_id = "123456789012"
alert_email         = "you@example.com"
enable_cloudfront   = false # Deploy the core stack before the CDN.

